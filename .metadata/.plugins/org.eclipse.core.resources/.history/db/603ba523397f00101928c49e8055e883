/*
 * 	* 구현 완료 순서
 * 		1) Model Layer
 * 			- User.java 
 * 			- Serializable 구현
 * 		2) Pesistance Layer
 * 			- FileManager.java
 * 		3) Repository Layer
 * 			- UserReposiotry.java
 * 			- CRUD 메서드 구현
 * 		4) Service Layer
 * 			- 비즈니스 로직 적용
 * 			- 예외 처리 구현 
 * 		5) Util Layer
 * 			- Constant.java
 * 		6) Controller Layer
 * 			- UserController.java 		
 * 											- 회원가입 테스트
 * 		7) Main Application
 * 			- Main.java			
 */
public class Main {
    public static void main(String[] args) {
        try {
            // 파일 경로 상수 사용
            String orderFilePath = "data/orders.dat";

            // 구체 구현체로 객체 생성
            OrderRepository orderRepo = new DefaultFileOrderRepository(orderFilePath);
            ProductRepository productRepo = new FileProductRepository();
            UserRepository userRepo = new FileUserRepository();
            AdminRepository adminRepo = new FileAdminRepository();

            // FileOrderRepository 타입 캐스팅
            FileOrderRepository fileOrderRepo = (orderRepo instanceof FileOrderRepository) ?
                    (FileOrderRepository) orderRepo : null;

            // 서비스 계층 생성 및 주입
            OrderService orderService = new OrderService(orderRepo, productRepo, fileOrderRepo);
            ProductService productService = new ProductService((FileProductRepository) productRepo);
            UserService userService = new UserService((FileUserRepository) userRepo);
            AdminService adminService = new AdminService(adminRepo);

            // 인증 및 권한 서비스
            AuthService authService = new AuthService(userRepo, adminRepo);
            AuthorizationService authorizationService = new AuthorizationService(authService);

            // 관리자 계정 기본 생성 (없을 시)
            if (adminRepo.count() == 0) {
                Admin admin = authService.registerAdmin("admin", "admin123", "admin@shopping.com", "관리자");
                System.out.println("관리자 계정 생성: " + admin.getId());
            }

            // 기본 사용자 등록 테스트
            User user = authService.registerUser("user1", "pass1234", "user1@example.com", "테스트사용자");
            System.out.println("사용자 등록: " + user.getId());

            // 상품 등록 테스트
            Product prod = new Product();
            prod.setName("테스트 노트북");
            prod.setPrice(1500000);
            prod.setStock(10);
            prod.setCategory(ProductCategory.ELECTRONICS);
            Product savedProduct = productService.addProduct(prod);
            System.out.println("상품 등록 완료: " + savedProduct.getId());

            // 주문 생성 테스트
            OrderItem item = new OrderItem(savedProduct.getId(), 1, savedProduct.getPrice());
            List<OrderItem> items = List.of(item);
            Order order = orderService.placeOrder(user.getId(), items, Role.USER);
            System.out.println("주문 생성 ID: " + order.getOrderId());

            // 주문 상태 변경 테스트
            orderService.confirmOrder(order.getOrderId(), user.getId(), Role.USER, null);
            System.out.println("주문 상태 변경 후: " + order.getStatus());

            // 사용자 로그인 테스트
            Role loginRole = authService.login("user1@example.com", "pass1234");
            System.out.println("사용자 로그인 성공, 권한: " + loginRole);

        } catch (Exception e) {
            System.err.println("오류 발생: " + e.getMessage());
            e.printStackTrace();
        }
    }
}